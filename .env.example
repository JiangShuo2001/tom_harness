# Copy this file to .env and fill in your own values.
# Do NOT commit the real .env (it is gitignored).

# LLM endpoint — an OpenAI-compatible Chat Completions API
TOM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Your API key for the endpoint
TOM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model name on that endpoint
TOM_MODEL=qwen3-32b

# Sampling temperature (0.0 = deterministic, higher = more creative)
TOM_TEMPERATURE=0.0

# ── Helper model (selector / category classifier) ──────────────────
# Used by the memory selector and RAG category classifier.
# Independent of the test model above.
HELPER_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
HELPER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HELPER_MODEL=qwen-turbo
